# === Discordボット基本設定 ===
DISCORD_TOKEN=
CLIENT_ID=
# 永続化DB(.json)の保存先パス。未設定なら ./data/db.json (プロジェクト直下)に自動作成される
DB_FILE_PATH=
# 設定するとそのギルド限定でスラッシュコマンドが即時反映されます(未設定ならグローバル反映・反映まで最大1時間程度)
# 管理画面(ADMIN_PANEL_*)を使う場合は必須(権限確認の対象サーバーとして使う)
GUILD_ID=

# === 入退室ログ ===
# 送信先チャンネルIDを指定してください。未設定の場合はそのログを送信しません。
JOIN_LOG_CHANNEL_ID=
LEAVE_LOG_CHANNEL_ID=

# === モデレーションログ(重大度別) ===
# 各重大度ごとに送信先チャンネルIDを指定してください。未設定の場合はそのログを送信しません。
# 軽度: warn / nickname-reset / voice-mute / voice-unmute / slowmode
MOD_LOG_MINOR_CHANNEL_ID=
# 中度: timeout / untimeout / kick / voice-deafen / voice-undeafen / lock / unlock / purge
MOD_LOG_MODERATE_CHANNEL_ID=
# 重度: ban / unban / softban
MOD_LOG_SEVERE_CHANNEL_ID=

# 重度ログ送信時にメンションするロールID(モデレーション権限を持つロール)
MODERATOR_ROLE_ID=

# === 鯖タグ(Server Tag)連動ロール ===
# どのサーバーの鯖タグを見るか。未設定ならGUILD_ID(このボットが動いているサーバー)が対象になる
SERVER_TAG_GUILD_ID=
# 鯖タグを着用しているメンバーに自動付与し、非着用になったら自動剥奪するロールID
# 未設定の場合はこの機能自体が無効
SERVER_TAG_ROLE_ID=1526898319115423815

# === 自動検知(荒らし対策) ===
# 自動検知全体のON/OFF
AUTOMOD_ENABLED=true
# trueにすると削除/タイムアウト等の自動対応を止めてログ送信のみ行う(お試しモード)
AUTOMOD_LOG_ONLY=false
# このロールを持つメンバーは自動検知の対象外にする(カンマ区切り、複数可)
# ※ サーバー管理権限(ManageGuild)を持つメンバーは常に対象外
AUTOMOD_EXEMPT_ROLE_IDS=

# --- 連投/フラッド系 ---
# 同一内容のメッセージを何回連投したら検知するか / 判定する時間幅(ミリ秒)
AUTOMOD_DUPLICATE_LIMIT=3
AUTOMOD_DUPLICATE_WINDOW_MS=10000
# 内容を問わず何件/時間で送ったらフラッド判定するか
AUTOMOD_FLOOD_LIMIT=6
AUTOMOD_FLOOD_WINDOW_MS=5000
# 添付ファイルを連投したときの検知件数/時間
AUTOMOD_ATTACHMENT_LIMIT=4
AUTOMOD_ATTACHMENT_WINDOW_MS=10000
# 同一内容を何チャンネルに投稿したらクロスポストスパム扱いにするか
AUTOMOD_CROSSPOST_CHANNEL_LIMIT=3
AUTOMOD_CROSSPOST_WINDOW_MS=15000

# --- メンション/絵文字/大文字/装飾テキスト ---
# 1メッセージ中のメンション数の上限
AUTOMOD_MENTION_LIMIT=5
# 1メッセージ中の絵文字数の上限
AUTOMOD_EMOJI_LIMIT=10
# 大文字乱用の判定を行う最低文字数 / 大文字比率の閾値(0〜1)
AUTOMOD_CAPS_MIN_LENGTH=10
AUTOMOD_CAPS_RATIO=0.7
# Zalgo(結合文字を大量に使った装飾)テキストの検知有無 / 1文字あたりの結合文字数閾値
AUTOMOD_BLOCK_ZALGO=true
AUTOMOD_ZALGO_MAX_MARKS_PER_CHAR=2

# --- リンク/招待検知 ---
AUTOMOD_BLOCK_INVITE_LINKS=true
# 許可する招待コード(自サーバーの招待など、カンマ区切り)
AUTOMOD_INVITE_ALLOWLIST=
AUTOMOD_BLOCK_SCAM_LINKS=true
# 詐欺検知のキーワードを追加したい場合はカンマ区切りで指定(組み込みのリストに追加される)
AUTOMOD_SCAM_EXTRA_KEYWORDS=
# 1メッセージ中のURL数の上限(招待リンク以外の広告/フィッシングURL連投対策)
AUTOMOD_URL_LIMIT=5

# --- 招待リンクの「作成」スパム対策(レイド用の大量発行を防ぐ) ---
# 何件の招待リンクをこの時間幅(ミリ秒)以内に作成したらスパムとみなすか
AUTOMOD_INVITE_CREATE_LIMIT=5
AUTOMOD_INVITE_CREATE_WINDOW_MS=60000

# --- ニックネーム変更スパム対策 ---
AUTOMOD_NICKNAME_CHANGE_LIMIT=4
AUTOMOD_NICKNAME_CHANGE_WINDOW_MS=60000

# --- アンチNuke(チャンネル/ロールの大量削除からサーバーを守る) ---
# ボットに「監査ログを見る」権限が必要
AUTOMOD_ANTI_NUKE_ENABLED=true
# 何回の削除をこの時間幅(ミリ秒)以内に検知したら自動BANするか
AUTOMOD_ANTI_NUKE_LIMIT=3
AUTOMOD_ANTI_NUKE_WINDOW_MS=20000

# --- NGワード ---
# 禁止ワード(部分一致・カンマ区切り) / 追加の正規表現(未設定で無効)
AUTOMOD_BANNED_WORDS=
AUTOMOD_BANNED_WORDS_REGEX=
# 重大NGワード(検知時は即キック・重度ログでモデレーターにメンション)
AUTOMOD_SEVERE_BANNED_WORDS=

# --- レイド対策(参加系) ---
# 何人がこの時間幅(ミリ秒)以内に参加したらレイドとみなすか
AUTOMOD_RAID_JOIN_LIMIT=10
AUTOMOD_RAID_JOIN_WINDOW_MS=10000
# レイド検知時にサーバーの参加認証レベルを自動的に最高まで引き上げるか
AUTOMOD_RAID_AUTO_LOCKDOWN=false

# 何ミリ秒未満で作成されたアカウントを「新規アカウント」として検知するか(0で無効)
AUTOMOD_MIN_ACCOUNT_AGE_MS=0
# 新規アカウント検知時の対応: flag(ログのみ) または kick(自動キック)
AUTOMOD_NEW_ACCOUNT_ACTION=flag
# ランダム英数字のような不審なユーザー名(量産アカウントの疑い)をログに残すか
AUTOMOD_FLAG_SUSPICIOUS_USERNAME=true

# === 管理画面(Web) ===
# 管理画面全体のON/OFF
ADMIN_PANEL_ENABLED=true
# リッスンするポート/アドレス。MrtCloud等のホスティングパネルが PORT / HOST を自動で
# 割り当てる場合はそちらが優先されるので、通常はここを編集する必要はない
# (パネルの指定がないローカル開発環境などでのみ ADMIN_PANEL_PORT が使われる)
ADMIN_PANEL_PORT=3000
# 管理画面に外部からアクセスするための公開URL(末尾にスラッシュを付けない)
# 例: https://your-bot.example.com や https://xxxx.mrtcloud.example のようにホスト側が割り当てたURL
# (リッスンするポート/アドレスとは別物。/admin-loginコマンドの返信でこのURLを案内するために使う)
ADMIN_PANEL_BASE_URL=http://localhost:3000
# ログインセッションの署名用シークレット(未設定だと再起動のたびに全員ログアウトされる)
SESSION_SECRET=
